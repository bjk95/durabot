{
	"name": "durabot-test",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	"main": "./test/worker.ts",
	"durable_objects": { "bindings": [{ "name": "BotAgent", "class_name": "BotAgent" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotAgent"] }],
	"d1_databases": [{ "binding": "DB", "database_name": "durabot-test", "database_id": "test" }],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "durabot-files-test" }],
	"vars": {
		"MODEL_BACKEND": "faux",
		"DEFAULT_MODEL": "faux-1",
		"SUMMARY_MODEL": "faux-1",
		"OWNER_TIMEZONE": "Europe/Madrid",
		"COMPOSIO_API_KEY": "test-key",
		"OPENROUTER_API_KEY": "test-key"
	}
}
