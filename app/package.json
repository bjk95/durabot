{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types --strict-vars false && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types --strict-vars false",
    "postinstall": "wrangler types --strict-vars false",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply durabot --local",
    "db:migrate:remote": "wrangler d1 migrations apply durabot --remote"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.29",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@composio/core": "^0.25.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "agents": "^0.28.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}